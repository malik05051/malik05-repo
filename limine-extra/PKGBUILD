# Maintainer: malik05051 <belhajjimalik1@gmail.com>

_pkgname=Limine-extra
_tag=v12.9.3-extra

pkgname=limine-extra
# A pkgver may not contain a hyphen; the tag's becomes a dot.
pkgver=${_tag#v}
pkgver=${pkgver//-/.}
pkgrel=1
# pacman compares the text after the last dot as text, so each change of
# scheme would sort below what came before without a new epoch: 1 for the move
# from 12.9.0.r4468.g7ad9085c to 12.9.1.modified, 2 for the move from
# 12.9.3.modified to 12.9.3.extra.
epoch=2
pkgdesc='Limine bootloader with systemd Boot Loader Interface support'
arch=('x86_64')
url='https://github.com/malik05051/Limine-extra'
license=('BSD-2-Clause')
depends=('glibc' 'bash' 'coreutils' 'util-linux' 'gawk' 'findutils' 'grep' 'sed')
makedepends=('git' 'autoconf' 'automake' 'nasm' 'mtools' 'llvm' 'clang' 'lld')
# Takes over from Arch's limine, and from this package's earlier names:
# limine-systemd-bootctl, and limine for a short while.
provides=('limine' 'limine-systemd-bootctl')
conflicts=('limine' 'limine-systemd-bootctl')
replaces=('limine' 'limine-systemd-bootctl')
# The EFI and BIOS blobs are firmware images, not host executables; leave them
# exactly as the build produced them.
options=('!strip' '!debug')
source=("git+${url}.git#tag=${_tag}"
        'limine-esp-sync.hook'
        'limine-esp-sync'
        'limine-esp-sync.conf.example'
        'limine-uki-profiles'
        'limine-hook-forward'
        'forward-install.hook'
        'forward-upgrade.hook')
sha256sums=('SKIP'
            '78a51bea648d1ea6893ef2317a0b4872b147034006b51cdb91983233099ac360'
            '3dec5c5fb3912a0a7d7a51708aa81ba64be0b8ff968a2175fafc6c2d0f0501d4'
            'f4cc257e1701bc060fcc6f8bca45b1ac89f203d23b1bef1c6dccc1dc351c6860'
            '73a50f7b879f1b6ab495c1d50de6587259ebd109fd8cb185e711a4f89ea9f660'
            'd8c87182332fb47f279248ab0cd3838e223a06d39fd31d3acce3d23c43afb02a'
            '8cb2cddcca159675040c2b3df3991cf2d4cdda538fa506478c201efa54ac36d6'
            '1cb9e1f3384bb3a4b49cff52ebea418469eaaa048fed924443efeb377e93278f')

pkgver() {
    cd "${_pkgname}"

    # A pkgver may not contain a hyphen, so the one in the tag becomes a dot.
    # The loader still reports the tag as it is written: version.sh feeds
    # LoaderInfo, and it has no such restriction.
    git describe --tags | sed 's/^v//; s/-/./g'
}

prepare() {
    cd "${_pkgname}"

    # Fetches the vendored dependencies listed in 3RDPARTY.md and generates
    # the configure script; needs network access.
    ./bootstrap
}

build() {
    cd "${_pkgname}"

    # Left to itself configure picks clang, ld.lld and the llvm- binutils,
    # which is the toolchain the tree cross-compiles every port with. Naming
    # one explicitly means naming a prefix, which is not what is wanted here.
    ./configure \
        --prefix=/usr \
        --enable-all

    make
}

package() {
    cd "${_pkgname}"

    make DESTDIR="${pkgdir}" install

    cd "${srcdir}"

    # Hooks match a package by name, never by what it provides, so those
    # written for Arch's limine are run from these on its behalf. Copying the
    # loader onto the ESP directly is opt-in: that hook does nothing until
    # /etc/limine-esp-sync.conf exists.
    install -Dm0644 forward-install.hook "${pkgdir}/usr/share/libalpm/hooks/80-limine-extra-forward-install.hook"
    install -Dm0644 forward-upgrade.hook "${pkgdir}/usr/share/libalpm/hooks/80-limine-extra-forward-upgrade.hook"
    install -Dm0755 limine-hook-forward "${pkgdir}/usr/share/libalpm/scripts/limine-hook-forward"
    install -Dm0644 limine-esp-sync.hook         "${pkgdir}/usr/share/libalpm/hooks/95-limine-esp-sync.hook"
    install -Dm0755 limine-esp-sync         "${pkgdir}/usr/share/libalpm/scripts/limine-esp-sync"
    install -Dm0644 limine-esp-sync.conf.example         "${pkgdir}/usr/share/doc/limine/limine-esp-sync.conf.example"
    install -Dm0755 limine-uki-profiles "${pkgdir}/usr/bin/limine-uki-profiles"
}
