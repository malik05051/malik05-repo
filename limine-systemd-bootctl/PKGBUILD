# Maintainer: malik05051 <belhajjimalik1@gmail.com>

_pkgname=Limine-systemd-bootctl
_tag=v12.9.2-modified

pkgname=limine-systemd-bootctl
# A pkgver may not contain a hyphen; the tag's becomes a dot.
pkgver=${_tag#v}
pkgver=${pkgver//-/.}
pkgrel=2
# The version scheme changed from a commit count to the tag, and a tag such as
# 12.9.1.modified sorts *below* the 12.9.0.r4468.g7ad9085c packages already
# published: pacman compares "modified" against "r4468" as text. Without an
# epoch nobody who installed one of those would ever be offered this.
epoch=1
pkgdesc='Limine bootloader with systemd Boot Loader Interface support'
arch=('x86_64')
url='https://github.com/malik05051/Limine-systemd-bootctl'
license=('BSD-2-Clause')
depends=('glibc' 'bash' 'coreutils' 'util-linux' 'gawk' 'findutils' 'grep' 'sed')
makedepends=('git' 'autoconf' 'automake' 'nasm' 'mtools' 'llvm' 'clang' 'lld')
provides=('limine')
conflicts=('limine')
# The EFI and BIOS blobs are firmware images, not host executables; leave them
# exactly as the build produced them.
options=('!strip' '!debug')
source=("git+${url}.git#tag=${_tag}"
        'limine-esp-sync.hook'
        'limine-esp-sync'
        'limine-esp-sync.conf.example'
        'limine-uki-profiles'
        'limine-install.hook')
sha256sums=('SKIP'
            '78a51bea648d1ea6893ef2317a0b4872b147034006b51cdb91983233099ac360'
            '3267f6a95c9ca061c3109d5729efa2b96faa58e60d565fd1e93a62bae9f1d2d3'
            'f4cc257e1701bc060fcc6f8bca45b1ac89f203d23b1bef1c6dccc1dc351c6860'
            '73a50f7b879f1b6ab495c1d50de6587259ebd109fd8cb185e711a4f89ea9f660'
            '0ff2f3331030970e6d69a7dc5688085eb046d7530a9f6dccf739af05c5d7dc55')

pkgver() {
    cd "${_pkgname}"

    # A pkgver may not contain a hyphen, so the one in the tag becomes a dot.
    # The loader still reports the tag as it is written: version.sh feeds
    # LoaderInfo, and it has no such restriction.
    git describe --tags | sed 's/^v//; s/-/./g'
}

prepare() {
    cd "${_pkgname}"

    # Fetches the vendored dependencies listed in 3RDPARTY.md and generates
    # the configure script; needs network access.
    ./bootstrap
}

build() {
    cd "${_pkgname}"

    # Left to itself configure picks clang, ld.lld and the llvm- binutils,
    # which is the toolchain the tree cross-compiles every port with. Naming
    # one explicitly means naming a prefix, which is not what is wanted here.
    ./configure \
        --prefix=/usr \
        --enable-all

    make
}

package() {
    cd "${_pkgname}"

    make DESTDIR="${pkgdir}" install

    cd "${srcdir}"

    # limine-entry-tool deploys the loader from a hook that only matches a
    # package named limine; this one does the same for this package, and only
    # where that tool is installed. The direct copy stays opt-in: it does
    # nothing until /etc/limine-esp-sync.conf exists.
    install -Dm0644 limine-install.hook "${pkgdir}/usr/share/libalpm/hooks/80-limine-systemd-bootctl-install.hook"
    install -Dm0644 limine-esp-sync.hook         "${pkgdir}/usr/share/libalpm/hooks/95-limine-esp-sync.hook"
    install -Dm0755 limine-esp-sync         "${pkgdir}/usr/share/libalpm/scripts/limine-esp-sync"
    install -Dm0644 limine-esp-sync.conf.example         "${pkgdir}/usr/share/doc/limine/limine-esp-sync.conf.example"
    install -Dm0755 limine-uki-profiles "${pkgdir}/usr/bin/limine-uki-profiles"
}
