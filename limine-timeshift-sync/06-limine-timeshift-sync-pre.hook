# Runs after timeshift-autosnap has taken its snapshot, and before the kernel it
# captured is replaced on the ESP, so that snapshot keeps a kernel to boot.
[Trigger]
Type = Path
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz

[Action]
Description = Keeping kernels for Timeshift snapshots...
When = PreTransaction
Exec = /bin/sh -c '[ ! -x /usr/bin/limine-timeshift-sync ] || exec /usr/bin/limine-timeshift-sync'
