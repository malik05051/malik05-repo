#!/bin/bash
# Restores a Timeshift snapshot: by default the one the system was booted into
# from the Limine menu, which otherwise disappears again at the next reboot.
# Timeshift does the restore; its restore hook then puts the kernels the
# snapshot was taken with back on the ESP.

set -euo pipefail

readonly TS_CONF=/etc/timeshift/timeshift.json

NOTIFY=0
WAIT=0
NAME=""
ARGS=("$@")

usage() {
    cat <<EOF
Usage: limine-timeshift-restore [<snapshot>]
       limine-timeshift-restore --notify

  <snapshot>  The Timeshift snapshot to restore, e.g. 2026-09-26_12-24-42.
              Defaults to the one booted into; otherwise one is asked for.
  --notify    Show a desktop notification when booted into a snapshot,
              offering to restore it. Run at login by the autostart entry.
EOF
}

while [ $# -gt 0 ]; do
    case "$1" in
        --notify) NOTIFY=1 ;;
        --wait) WAIT=1 ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; exit 2 ;;
        *) NAME=$1 ;;
    esac
    shift
done

note() { echo "limine-timeshift-restore: $*"; }
warn() { echo "limine-timeshift-restore: $*" >&2; }
die() { warn "$*"; exit 1; }

# Launched in a terminal of its own, which would otherwise close before
# anything it printed could be read.
if [ "$WAIT" -eq 1 ]; then
    trap 'echo; read -r -p "Press Enter to close. " _ || true' EXIT
fi

booted_snapshot() {
    local cmdline
    cmdline=$(</proc/cmdline)
    if [[ $cmdline =~ subvol=/?timeshift-btrfs/snapshots/([^/[:space:],]+)/@([[:space:],]|$) ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    return 1
}

is_graphical() {
    [ "${XDG_SESSION_TYPE:-}" = x11 ] || [ "${XDG_SESSION_TYPE:-}" = wayland ]
}

# The restore asks for confirmation, so it needs a terminal to run in.
open_terminal() {
    local -a term auth cmd
    if [ -n "${TERMINAL:-}" ] && command -v "$TERMINAL" >/dev/null 2>&1; then
        term=("$TERMINAL" -e)
    else
        local t
        for t in konsole kgx gnome-terminal ptyxis xfce4-terminal qterminal mate-terminal \
                 cosmic-term foot kitty alacritty wezterm ghostty xterm; do
            command -v "$t" >/dev/null 2>&1 || continue
            case "$t" in
                gnome-terminal|ptyxis) term=("$t" --) ;;
                wezterm) term=("$t" start --) ;;
                *) term=("$t" -e) ;;
            esac
            break
        done
    fi
    [ "${#term[@]}" -gt 0 ] || die "no terminal found; set TERMINAL or run 'sudo limine-timeshift-restore' in one"

    if command -v pkexec >/dev/null 2>&1; then
        auth=(pkexec)
    else
        auth=(sudo)
    fi
    cmd=("${auth[@]}" /usr/bin/limine-timeshift-restore --wait)
    [ -z "$1" ] || cmd+=("$1")

    case "${term[0]}" in
        xfce4-terminal|mate-terminal)
            # These take the command as one string.
            "${term[@]}" "${cmd[*]}"
            ;;
        *)
            "${term[@]}" "${cmd[@]}"
            ;;
    esac
}

if [ "$NOTIFY" -eq 1 ]; then
    name=$(booted_snapshot) || exit 0
    [ "$(id -u)" -ne 0 ] || exit 0
    command -v notify-send >/dev/null 2>&1 || exit 0
    when="${name:0:10} ${name:11:2}:${name:14:2}"
    action=$(notify-send --urgency=critical --expire-time=0 \
        --app-name="Snapshot detected!" --icon=timeshift \
        --action="restore=Restore now" \
        "Snapshot detected!" \
        "This is the Timeshift snapshot from $when, not your installed system. Restore it to keep it; changes made here are lost when you reboot into your system." \
        2>/dev/null) || exit 0
    if [ "$action" = restore ]; then
        open_terminal "$name"
    fi
    exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
    if is_graphical && [ ! -t 0 ]; then
        open_terminal "$NAME"
        exit 0
    fi
    exec sudo /usr/bin/limine-timeshift-restore "${ARGS[@]}"
fi

command -v timeshift >/dev/null 2>&1 || die "timeshift is not installed"

TOP=""
cleanup() {
    if [ -n "$TOP" ]; then
        umount "$TOP" 2>/dev/null || umount -l "$TOP" 2>/dev/null || true
        rmdir "$TOP" 2>/dev/null || true
    fi
}
trap 'cleanup' EXIT
if [ "$WAIT" -eq 1 ]; then
    trap 'cleanup; echo; read -r -p "Press Enter to close. " _ || true' EXIT
fi

[ "$(findmnt -no FSTYPE /)" = btrfs ] || die "/ is not on btrfs; this restores Timeshift snapshots in btrfs mode"
src=$(findmnt -no SOURCE /)
TOP=$(mktemp -d /run/limine-timeshift-restore.XXXXXX)
mount -o ro,subvolid=5 "${src%%\[*}" "$TOP"
snapdir="$TOP/timeshift-btrfs/snapshots"

json_field() {
    sed -n "s/^[[:space:]]*\"$2\"[[:space:]]*:[[:space:]]*\"\\(.*\\)\".*/\\1/p" "$1" 2>/dev/null | head -n1
}

booted=$(booted_snapshot || true)
if [ -z "$NAME" ]; then
    NAME=$booted
fi

if [ -z "$NAME" ]; then
    mapfile -t names < <(for d in "$snapdir"/*/@; do [ -d "$d" ] && basename "$(dirname "$d")"; done | sort -r)
    [ "${#names[@]}" -gt 0 ] || die "there are no Timeshift btrfs snapshots"
    echo "Timeshift snapshots, newest first:"
    for i in "${!names[@]}"; do
        n=${names[$i]}
        printf '  %2d  %s  %s  %s\n' $((i + 1)) "$n" \
            "$(json_field "$snapdir/$n/info.json" tags)" "$(json_field "$snapdir/$n/info.json" comments)"
    done
    read -r -p "Number of the snapshot to restore (Enter to cancel): " pick
    [ -n "$pick" ] || die "cancelled; nothing changed"
    if ! [[ "$pick" =~ ^[0-9]+$ ]] || [ "$pick" -lt 1 ] || [ "$pick" -gt "${#names[@]}" ]; then
        die "no snapshot number $pick"
    fi
    NAME=${names[$((pick - 1))]}
fi

[ -d "$snapdir/$NAME/@" ] || die "no Timeshift snapshot named $NAME"

info="$snapdir/$NAME/info.json"
echo
echo "Snapshot:    $NAME"
echo "Tags:        $(json_field "$info" tags)"
echo "Comment:     $(json_field "$info" comments)"
kernels=""
for m in "$snapdir/$NAME/@"/usr/lib/modules/*/; do
    [ -f "$m/vmlinuz" ] || continue
    kernels="$kernels $(head -n1 "$m/pkgbase" 2>/dev/null || echo linux) $(basename "$m"),"
done
echo "Kernels:    ${kernels%,}"
if [ "$NAME" = "$booted" ]; then
    echo "             (the snapshot running now)"
fi

home=no
if [ -f "$TS_CONF" ] && grep -Eq '"include_btrfs_home_for_restore"[[:space:]]*:[[:space:]]*"true"' "$TS_CONF"; then
    home=yes
fi
echo
if [ "$home" = yes ] && [ -d "$snapdir/$NAME/@home" ]; then
    echo "Timeshift will replace the system (@) and /home (@home) with this snapshot's."
    echo "Files saved in /home since then are kept only in the snapshot Timeshift"
    echo "takes of the current system before restoring."
else
    echo "Timeshift will replace the system (@) with this snapshot's; /home is not touched."
fi
echo "The kernels this snapshot was taken with are put back on the ESP afterwards."
echo

read -r -p "Restore $NAME? [y/N] " answer
case "$answer" in
    y|Y|yes|YES) ;;
    *) die "cancelled; nothing changed" ;;
esac

cleanup
TOP=""

log=$(mktemp /run/limine-timeshift-restore.log.XXXXXX)
status=0
timeshift --restore --snapshot "$NAME" --skip-grub --scripted 2>&1 | tee "$log" || status=$?

if ! grep -q "Restore completed" "$log"; then
    rm -f "$log"
    die "Timeshift did not complete the restore (exit status $status); see its output above"
fi
if grep -q "Failed to remove directory" "$log"; then
    note "Timeshift's 'Failed to remove directory' comes from cleaning up its temporary mounts after the restore completed; the restore itself is done."
fi
rm -f "$log"

echo
note "restored $NAME. It becomes the running system after a reboot."
read -r -p "Reboot now? [y/N] " answer
case "$answer" in
    y|Y|yes|YES)
        trap - EXIT
        systemctl reboot
        ;;
esac
