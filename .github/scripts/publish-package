#!/bin/bash
# Uploads a package, with its signature if there is one, to the "pacman"
# release of the repository releases.conf names for it, creating that release
# the first time. GH_TOKEN must be allowed to write to that repository.

set -eu

pkg=$1
tag=pacman
repo=$("$(dirname "$0")/release-repo" "$pkg") || {
    echo "::error::releases.conf names no repository for $(basename "$pkg")" >&2
    exit 1
}

if ! gh release view "$tag" --repo "$repo" >/dev/null 2>&1; then
    # A prerelease, so that it never shows as the project's latest release.
    gh release create "$tag" --repo "$repo" --prerelease \
        --title "Pacman packages" \
        --notes "Packages for the [malik05 pacman repository](https://github.com/malik05051/malik05-repo). Install them through pacman as described there."
fi

files=("$pkg")
if [ -e "$pkg.sig" ]; then
    files+=("$pkg.sig")
fi
gh release upload "$tag" --repo "$repo" "${files[@]}" --clobber
echo "published $(basename "$pkg") to $repo"
